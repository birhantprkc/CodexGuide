# Canonical documentation and SEO origin.
PUBLIC_SITE_URL=https://codexguide.ai

# Canonical origin approved for the paid community and Alipay website payment.
# Payment pages, sessions, return_url and notify_url must all use this exact origin.
COMMUNITY_SITE_URL=https://codexguide.ai

# Use false for a new installation. When adding WeChat Native to an existing
# Alipay deployment, preserve the current global value and keep only Native off.
COMMUNITY_PAYMENT_ENABLED=false

# Channel-level switches. Alipay falls back to the global switch when omitted.
ALIPAY_PAYMENT_ENABLED=true
WECHAT_NATIVE_PAYMENT_ENABLED=false

# Neon Postgres pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Alipay website payment. Use sandbox only for local testing; production values must
# come from one published Alipay application and must never be committed.
ALIPAY_ENV=production
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_ENABLED=true

# WeChat Pay API v3 Native. The app secret is not required. Responses and
# notifications are verified with the WeChat Pay public key (PUB_KEY_ID_...).
WECHAT_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=

# Generate three independent random values of at least 32 bytes each.
COMMUNITY_SESSION_SECRET=
COMMUNITY_BUYER_HMAC_SECRET=
ADMIN_SESSION_SECRET=

# Generate with pnpm admin:hash-password after securely exporting ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
